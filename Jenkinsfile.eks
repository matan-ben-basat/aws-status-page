// Second, independent pipeline: builds the same status-page app as a
// container and deploys it to the isolated EKS demo cluster (terraform-eks/,
// k8s/, in the statuspage-infra repo). Deliberately separate from the main
// Jenkinsfile — proves the same CI/CD controller (this Jenkins box) can
// drive two different deployment targets (VM-based and Kubernetes-based)
// without the two pipelines interfering with each other.
//
// Lives in THIS repo (not statuspage-infra) because `docker build` needs
// the Dockerfile that's checked out alongside it — same reasoning as why
// the main Jenkinsfile is duplicated here too.
pipeline {
    agent any

    environment {
        AWS_REGION   = 'us-east-1'
        ECR_REPO     = '<AWS_ACCOUNT_ID>.dkr.ecr.us-east-1.amazonaws.com/statuspage'
        EKS_CLUSTER  = 'statuspage-eks-demo'
        INFRA_DIR    = '/opt/statuspage-infra'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'echo $(git rev-parse --short HEAD) > .release_tag'
            }
        }

        stage('Build Image') {
            steps {
                sh 'docker build -t ${ECR_REPO}:$(cat .release_tag) -t ${ECR_REPO}:latest .'
            }
        }

        stage('Push to ECR') {
            steps {
                sh '''
                    aws ecr get-login-password --region ${AWS_REGION} \
                        | docker login --username AWS --password-stdin ${ECR_REPO%/*}
                    docker push ${ECR_REPO}:$(cat .release_tag)
                    docker push ${ECR_REPO}:latest
                '''
            }
        }

        stage('Deploy to EKS') {
            steps {
                sh '''
                    aws eks update-kubeconfig --name ${EKS_CLUSTER} --region ${AWS_REGION}
                    kubectl set image deployment/statuspage \
                        statuspage=${ECR_REPO}:$(cat .release_tag) -n statuspage
                    kubectl rollout status deployment/statuspage -n statuspage --timeout=120s
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    LB_HOST=$(kubectl get svc statuspage -n statuspage -o jsonpath='{.status.loadBalancer.ingress[0].hostname}')
                    bash ${INFRA_DIR}/jenkins/scripts/health_check.sh "$LB_HOST"
                '''
            }
        }
    }

    post {
        failure {
            echo 'EKS pipeline failed — see stage logs above. Main VM-based pipeline is unaffected.'
        }
    }
}
