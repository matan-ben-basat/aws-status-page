# Wildcard ('*') disabled Django's Host-header validation entirely, letting an
# attacker send a spoofed Host header and poison any absolute URL the app
# builds from request.get_host() (e.g. password-reset links). The LoadBalancer
# Service's hostname is only known after Terraform/kubectl create it (a
# chicken-and-egg problem for a Deployment env var baked in ahead of time), so
# scope to the domain suffix AWS actually issues LB hostnames under instead —
# still validates real requests, and nobody outside AWS can register a host
# under this suffix, unlike a bare '*'.
ALLOWED_HOSTS = ['.elb.amazonaws.com']

